rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Testimonials collection: public read, auth-required write
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Projects collection: public read, auth-required write
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Settings collection: public read, auth-required write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
