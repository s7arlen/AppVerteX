rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Testimonials collection: public read, authenticated schema-validated write
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
    }
    
    // Projects collection: public read, authenticated schema-validated write
    match /projects/{projectId} {
      allow read: if true;
      allow delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150;
    }
    
    // Settings collection: public read, authenticated write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
